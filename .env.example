# ============================================
# Mobix — Multi-tenant phone store SaaS
# Environment: development
# ============================================

# ============================================
# Database
# ============================================
# Prisma reads this. Port 5434 matches the
# phone-store-postgres Docker container.
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/phone_store_db?schema=public"

# ============================================
# Server
# ============================================
PORT=3000
NODE_ENV=development

# Comma-separated list of allowed browser origins.
# Add your frontend URLs here as you build them.
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# ============================================
# JWT
# ============================================
# Two separate secrets. Never reuse the same value
# for both. Never commit real production values.
#
# Generate strong secrets with:
#   openssl rand -base64 32
#
# Changing these invalidates every issued token.
JWT_ACCESS_SECRET="dev-access-secret-do-not-use-in-prod"
JWT_REFRESH_SECRET="dev-refresh-secret-do-not-use-in-prod"

# Access token: short-lived, sent on every request.
# Refresh token: long-lived, sent only to /refresh.
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# iss and aud claims. Both must match between
# sign (getJwtAccessOptions) and verify (JwtStrategy).
# Changing these invalidates every issued token.
JWT_ISSUER="mobix"
JWT_AUDIENCE="mobix-api"

# ============================================
# Password hashing
# ============================================
# The pepper is mixed into every password before hashing.
# It is a defense-in-depth measure: if the DB leaks but
# the pepper does not, cracking becomes far harder.
#
# CRITICAL: never change this once users exist.
# Every existing password becomes unverifiable.
#
# For local development you may leave it empty ("").
# Then the hasher uses no pepper. Argon2id alone is
# still strong.
PASSWORD_PEPPER="dev-pepper-do-not-use-in-prod"

# ============================================
# Logging (optional)
# ============================================
# LOG_LEVEL=debug
# LOG_PRETTY=true

# ============================================
# Future integrations (not used yet)
# ============================================
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# REDIS_URL=redis://localhost:6380
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="noreply@mobix.local"