# ============================================
# Compiled output
# ============================================
/dist
/build
/node_modules

# TypeScript build cache
*.tsbuildinfo

# ============================================
# Logs
# ============================================
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ============================================
# Environment variables (SECRETS - never commit)
# ============================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# Keep a template for other developers
!.env.example

# ============================================
# Prisma
# ============================================
# Generated client (regenerated via `prisma generate`)
/generated/prisma/
node_modules/.prisma/

# Local SQLite DB files if you ever use one
*.db
*.db-journal
*.sqlite
*.sqlite3

# Prisma migrate lock/temp files
prisma/*.db
prisma/*.db-journal

# ============================================
# Tests & Coverage
# ============================================
/coverage
/.nyc_output
*.lcov

# ============================================
# OS
# ============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ============================================
# IDEs and editors
# ============================================
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.swp
*.swo
*~

# VSCode - keep shared config
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ============================================
# Temp directory
# ============================================
.temp
.tmp
tmp/

# ============================================
# Runtime data
# ============================================
pids
*.pid
*.seed
*.pid.lock

# ============================================
# Diagnostic reports
# ============================================
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ============================================
# NestJS specific
# ============================================
# Nest CLI cache
.nest/

# ============================================
# Docker (local overrides, do NOT commit secrets)
# ============================================
docker-compose.override.yml
docker-compose.*.local.yml

# ============================================
# Package manager lock files (keep one, ignore others)
# ============================================
# If you use npm, ignore these:
# yarn.lock
# pnpm-lock.yaml
# package-lock.json  <- keep this if using npm